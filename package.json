    "@supabase/supabase-js": "^2.112.3",
    "fast-xml-parser": "^5.2.5",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.2.10"
  }
}
