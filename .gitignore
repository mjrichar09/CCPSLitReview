# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# env files — never commit secrets. The example carries no values, so it stays.
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Pipeline staging artifacts.
# raw.json and normalized.json are large and free to regenerate — no LLM spend
# sits behind them. scored.json IS committed (a future routine-based generator
# has to read it from the repo), so it is deliberately NOT ignored here.
/data/digest/staging/**/raw.json
/data/digest/staging/**/normalized.json
