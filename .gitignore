# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
.pnpm-debug.log*

# env files — never commit secrets. The example carries no values, so it stays.
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Generated at build time by scripts/build-search-index.mjs (predev/prebuild
# hooks run it before either dev or build ever serves this file) — a stale
# committed copy would never be the one users actually see, so it's free to
# regenerate and not worth the monthly diff noise.
/public/search-index.json

# Pipeline staging artifacts.
# raw.json and normalized.json are large and free to regenerate — no LLM spend
# sits behind them. scored.json IS committed — the generation routine reads it
# from the repo (see CLAUDE.md, "Generation runs on a routine") — so it is
# deliberately NOT ignored here.
/data/digest/staging/**/raw.json
/data/digest/staging/**/normalized.json
# summarized/synthesized hold the generated prose, which is already the month
# file's content verbatim. Committing them would double the repo's growth every
# month to store the same text twice.
/data/digest/staging/**/summarized.json
/data/digest/staging/**/synthesized.json
# routine-input/routine-output are the generation routine's own scratch
# artifacts (scripts/prep-for-routine.mjs / finalize-routine-output.mjs),
# regenerated fresh in its ephemeral clone every run — same reasoning as
# summarized/synthesized above.
/data/digest/staging/**/routine-input.json
/data/digest/staging/**/routine-output.json
