# Copy to .env.local and fill in what you have. .env* is gitignored — never commit
# real values. In CI these live in GitHub Actions secrets instead.

# Optional. Raises the PubMed rate limit from 3 to 10 requests/second.
# Without it the run still succeeds and notes the degradation in source_health.
NCBI_API_KEY=

# Required from Phase 2 onward (scoring, summarising, synthesising).
ANTHROPIC_API_KEY=

# Optional. Only needed if a stage in config/digest.config.js is pointed at Groq.
GROQ_API_KEY=

# Reader feedback (votes and comments). Both are publishable by design — they
# ship to the browser in the built bundle, and access control is row-level
# security in Postgres, not key secrecy. Set these in Vercel too; without them
# the site still builds and renders, just with the feedback widgets absent.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reading reader-imported papers back into the generation stage (optional).
# Server-side only — Actions secrets, never Vercel's NEXT_PUBLIC_* and never a
# browser. `user_papers` and `comments` are readable only by an approved,
# signed-in reader, and the pipeline is neither, so this is the one read that
# the publishable key cannot do. Absent, months generate normally without
# import context. See lib/importedPapers.js.
SUPABASE_SERVICE_ROLE_KEY=
